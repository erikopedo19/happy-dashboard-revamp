{
  "expo": {
    "name": "Cutzioo",
    "slug": "cutzioo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "../public/icons/icon-512x512.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B0B0F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cutzioo.app",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Cutzioo uses the camera when you choose to capture a profile image.",
        "NSPhotoLibraryUsageDescription": "Cutzioo uses selected photos for profile images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "../public/icons/icon-512x512.png",
        "backgroundColor": "#0B0B0F"
      },
      "package": "com.cutzioo.app"
    },
    "web": {
      "favicon": "../public/favicon.ico"
    }
  }
}
